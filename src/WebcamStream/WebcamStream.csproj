<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>WebcamStream</RootNamespace>
    <AssemblyName>WebcamStream</AssemblyName>
    <Version>1.0.11</Version>
    <Description>Low-CPU webcam RTSP server for Windows.</Description>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);SELF_CONTAINED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\config.jsonc">
      <LogicalName>WebcamStream.DefaultConfig.jsonc</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
